{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent OS Runtime Adapter Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "updated_at",
    "default_adapter_id",
    "selection_policy",
    "adapters",
    "agent_bindings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "default_adapter_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "selection_policy": {
      "enum": [
        "capability_first",
        "pinned_only"
      ]
    },
    "agent_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id",
          "adapter_id",
          "status"
        ],
        "properties": {
          "agent_id": {
            "type": "string"
          },
          "adapter_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "draft",
              "approved",
              "disabled"
            ]
          }
        }
      }
    },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "transport",
          "lifecycle_status",
          "runtime_status",
          "implementation_status",
          "entrypoint",
          "capabilities",
          "official_docs",
          "runtime_evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "transport": {
            "enum": [
              "http_sse",
              "jsonl_stdio",
              "sdk_process"
            ]
          },
          "lifecycle_status": {
            "enum": [
              "draft",
              "in_review",
              "approved",
              "retired"
            ]
          },
          "runtime_status": {
            "enum": [
              "not_deployed",
              "configured",
              "running",
              "suspended",
              "unknown"
            ]
          },
          "implementation_status": {
            "enum": [
              "planned",
              "prototype",
              "implemented"
            ]
          },
          "entrypoint": {
            "type": "string",
            "minLength": 1
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "submit",
              "status",
              "events",
              "cancel",
              "approval",
              "resume",
              "idempotency",
              "permissions",
              "usage",
              "multi_agent"
            ],
            "properties": {
              "submit": {
                "enum": [
                  "implemented",
                  "planned",
                  "host_dependent"
                ]
              },
              "status": {
                "enum": [
                  "implemented",
                  "local_only",
                  "planned",
                  "host_dependent"
                ]
              },
              "events": {
                "enum": [
                  "implemented",
                  "planned",
                  "host_dependent"
                ]
              },
              "cancel": {
                "enum": [
                  "implemented",
                  "force_close",
                  "planned",
                  "host_dependent"
                ]
              },
              "approval": {
                "enum": [
                  "implemented",
                  "callback",
                  "not_configured",
                  "planned",
                  "host_dependent"
                ]
              },
              "resume": {
                "enum": [
                  "implemented",
                  "host_dependent",
                  "planned"
                ]
              },
              "idempotency": {
                "enum": [
                  "native",
                  "external_ledger_required",
                  "planned"
                ]
              },
              "permissions": {
                "enum": [
                  "host_config_required",
                  "sandbox_policy",
                  "callback",
                  "host_dependent"
                ]
              },
              "usage": {
                "enum": [
                  "implemented",
                  "host_dependent",
                  "unknown"
                ]
              },
              "multi_agent": {
                "enum": [
                  "host_dependent",
                  "unknown",
                  "planned"
                ]
              }
            }
          },
          "official_docs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "runtime_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
