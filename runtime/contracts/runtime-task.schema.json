{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent OS Runtime Task Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskId",
    "agentId",
    "idempotencyKey",
    "prompt",
    "riskTier",
    "requiredCapabilities",
    "permissionsRequired"
  ],
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "agentId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[!-~]+$"
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "workingDirectory": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "instructions": {
      "type": [
        "string",
        "null"
      ]
    },
    "riskTier": {
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3"
      ]
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissionsRequired": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read",
        "write",
        "externalActions"
      ],
      "properties": {
        "read": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "write": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "externalActions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "approval": {
      "type": [
        "object",
        "null"
      ]
    },
    "budget": {
      "type": [
        "object",
        "null"
      ]
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
