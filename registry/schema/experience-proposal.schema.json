{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent OS Experience Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "title",
    "scope",
    "status",
    "owner",
    "source_task_refs",
    "trigger",
    "problem",
    "proposed_change",
    "steps",
    "acceptance_criteria",
    "failure_signals",
    "counterexamples",
    "evidence",
    "test_cases",
    "privacy_review",
    "approval",
    "merge_target",
    "rollback",
    "version",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^exp-[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "enum": [
        "project",
        "skill",
        "core"
      ]
    },
    "status": {
      "enum": [
        "candidate",
        "redacted",
        "in_review",
        "tested",
        "approved",
        "rejected",
        "merged",
        "deprecated"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "source_task_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "trigger": {
      "type": "string",
      "minLength": 1
    },
    "problem": {
      "type": "string",
      "minLength": 1
    },
    "proposed_change": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "failure_signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counterexamples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "scenario",
          "expected",
          "result"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "positive",
              "negative"
            ]
          },
          "scenario": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "not_run"
            ]
          }
        }
      }
    },
    "privacy_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "passed",
            "rejected"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "approver",
        "approved_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "approver": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "merge_target": {
      "type": [
        "string",
        "null"
      ]
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
